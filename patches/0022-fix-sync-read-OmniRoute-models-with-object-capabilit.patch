diff --git a/docs/custom-providers.md b/docs/custom-providers.md
index 7c1c785..19a63ae 100644
--- a/docs/custom-providers.md
+++ b/docs/custom-providers.md
@@ -28,7 +28,7 @@ Edit each model's pins offline:
 
 Positive integer token pins are accepted, including small output limits; blank removes a pin. The editor labels reported, fallback, and pinned values. **These are request/compaction budgets, not commands to resize the backend's context.** Configure the server separately and match its active limits. Reconnecting prunes pins only to the resulting model IDs.
 
-Reasoning support declares a capability; it does not enable execution. The normal Pi effort picker remains available, but **Off may not disable a backend's default thinking**. There is no model-name inference, Ollama preset, thinking-map/compatibility editor, or nonstandard-header editor.
+Reasoning support declares a capability; it does not enable execution. The normal Pi effort picker remains available, but **Off may not disable a backend's default thinking**. There is no model-name inference, Ollama preset, thinking-map/compatibility editor, or nonstandard-header editor. Reported support is read from discovery metadata only: explicit booleans (`reasoning`/`supports_reasoning`/`thinking`), capability/parameter lists (vLLM, OpenRouter), and object-shaped capabilities (`{"reasoning": true, …}`, OmniRoute). Image capability is read from the same shapes ("vision"/"image" tokens or `vision: true`).
 
 ## Images
 
diff --git a/src/server/custom-provider.ts b/src/server/custom-provider.ts
index 6d63b2e..97cba4e 100644
--- a/src/server/custom-provider.ts
+++ b/src/server/custom-provider.ts
@@ -178,7 +178,7 @@ function modelRows(body: unknown): unknown[] | null {
  *  capability fields; absent or unrecognized → false (text-only). */
 function detectImage(row: Record<string, unknown>): boolean {
 	const architecture = isRecord(row.architecture) ? row.architecture : undefined;
-	const candidates = [
+	const candidates: unknown[] = [
 		architecture?.input_modalities,
 		row.input_modalities,
 		row.modalities,
@@ -188,7 +188,9 @@ function detectImage(row: Record<string, unknown>): boolean {
 	for (const c of candidates) {
 		if (Array.isArray(c) && c.some((v) => typeof v === "string" && /image|vision/i.test(v))) return true;
 	}
-	return false;
+	// OmniRoute-style object capabilities: {"vision": true, …}.
+	const caps = isRecord(row.capabilities) ? row.capabilities : undefined;
+	return caps?.vision === true;
 }
 
 /** Does a /models row advertise reasoning? Metadata only — no name guessing,
@@ -202,12 +204,16 @@ function detectReasoning(row: Record<string, unknown>): boolean {
 		if (row[key] === true) return true;
 	}
 	const architecture = isRecord(row.architecture) ? row.architecture : undefined;
-	const candidates = [row.supported_parameters, row.capabilities, row.tags, architecture?.output_modalities];
-	return candidates.some(
+	const candidates: unknown[] = [row.supported_parameters, row.capabilities, row.tags, architecture?.output_modalities];
+	const listHit = candidates.some(
 		(list) =>
 			Array.isArray(list) &&
 			list.some((v) => typeof v === "string" && (/reasoning/i.test(v) || v.toLowerCase() === "thinking")),
 	);
+	if (listHit) return true;
+	// OmniRoute-style object capabilities: {"reasoning": true, "thinking": true, …}.
+	const caps = isRecord(row.capabilities) ? row.capabilities : undefined;
+	return Boolean(caps && (caps.reasoning === true || caps.supports_reasoning === true || caps.thinking === true));
 }
 
