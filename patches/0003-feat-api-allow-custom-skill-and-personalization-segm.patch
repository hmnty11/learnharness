From 6100e9b22e7d5f8263ea161633d0793977363830 Mon Sep 17 00:00:00 2001
From: hmty11 <darrenjeho@gmail.com>
Date: Thu, 29 Oct 2026 15:31:29 +0800
Subject: [PATCH 03/18] feat(api): allow custom skill and personalization
 segment updates

---
 app/api/settings/prompts/[...segment]/route.ts | 3 ++-
 src/server/index.ts                            | 2 +-
 2 files changed, 3 insertions(+), 2 deletions(-)

diff --git a/app/api/settings/prompts/[...segment]/route.ts b/app/api/settings/prompts/[...segment]/route.ts
index 8fed774..49c729e 100644
--- a/app/api/settings/prompts/[...segment]/route.ts
+++ b/app/api/settings/prompts/[...segment]/route.ts
@@ -27,6 +27,7 @@
 
 import {
 	allSegmentPaths,
+	isCustomSkillPath,
 	isValidSegmentPath,
 	promptOverrides,
 	readSettingsRecord,
@@ -50,7 +51,7 @@ export async function PUT(request: Request, ctx: { params: Promise<{ segment: st
 	if (!body || typeof body.text !== "string") {
 		return Response.json({ error: "body must be {text: string}" }, { status: 400 });
 	}
-	if (!new Set(allSegmentPaths()).has(path)) {
+	if (!isCustomSkillPath(path) && !new Set(allSegmentPaths()).has(path)) {
 		return Response.json(
 			{ error: `"${path}" is not a current source segment`, supported: allSegmentPaths() },
 			{ status: 400 },
diff --git a/src/server/index.ts b/src/server/index.ts
index 957c699..8784d8a 100644
--- a/src/server/index.ts
+++ b/src/server/index.ts
@@ -30,7 +30,7 @@ export {
 export { promptOverrides } from "../store/prompt-overrides.ts";
 export { themeStore } from "../store/themes.ts";
 export { readThemeBoot, type ThemeBoot } from "./theme-boot.ts";
-export { isValidSegmentPath } from "../core/prompt-segments.ts";
+export { isValidSegmentPath, isCustomSkillPath } from "../core/prompt-segments.ts";
 // The canonical segment discovery/resolution lives in the agent layer
 // (composition is an agent concern); the barrel re-exports it for the
 // routes — server→agent is the lawful direction (chat-handler precedent).
