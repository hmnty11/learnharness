+
+test('saving language setting updates store and informs graph and file preflights', async t => {
+  const h = harness(t, graph('p1'));
+  assert.equal(h.state().settings.language, 'auto');
+  await h.call('save-settings', { language: 'Indonesian' });
+  assert.equal(h.state().settings.language, 'Indonesian');
+
+  const graphPlan = await h.call('preflight', { propositionIds: ['p1'] });
+  assert.ok(graphPlan.id);
+  await h.call('start-generation', { preflightId: graphPlan.id, requestId: 'test-lang-graph' });
+  await flush();
+  const graphTask = h.workers.service.list().find(t => t.requestId === h.state().batch.chunks[0].requestId);
+  assert.ok(graphTask.prompt.includes('Language: Generate all facts, cues, questions, and answers in Indonesian.'));
+  await h.complete(graphTask, result(cards('p1', 'Pertanyaan', 'Jawaban')));
+  assert.equal(h.state().batch.status, 'completed');
+
+  const filePlan = await h.call('preflight-file', { name: 'test.md', markdown: '# Fact\nSome statement.' });
+  await h.call('start-generation', { preflightId: filePlan.id, requestId: 'test-lang-file' });
+  await flush();
+  const fileTask = h.workers.service.list().find(t => t.requestId === h.state().batch.chunks[0].requestId);
+  assert.ok(fileTask.prompt.includes('Language: Generate all facts, cues, questions, and answers in Indonesian.'));
+});
diff --git a/plugins/flashcards/tests/generation-prompts.test.cjs b/plugins/flashcards/tests/generation-prompts.test.cjs
index 878c8ea..6d30c44 100644
--- a/plugins/flashcards/tests/generation-prompts.test.cjs
+++ b/plugins/flashcards/tests/generation-prompts.test.cjs
@@ -119,3 +119,21 @@ test('graph and file full-request estimates still account for composed instructi
   const expectedFile = Math.ceil(Buffer.byteLength(prompts.fileInstructions + JSON.stringify(files.resultSchema) + prompts.filePromptFor(file), 'utf8') / 3) + 256;
   assert.equal(plan.prompt, prompts.filePromptFor(file)); assert.equal(plan.tokens, expectedFile);
 });
+
+test('graph and file generation prompts append target language instruction only when language is not auto', () => {
+  const graphInput = { targets: ['p'], propositions: [{ id: 'p', name: 'Fact', statement: 'Statement' }], chains: [], cards: [{ propositionId: 'p', active: [], deleted: [] }] };
+  const fileInput = { name: 'notes.md', markdown: 'Some source material.' };
+
+  for (const lang of [undefined, 'auto']) {
+    assert.equal(prompts.graphPromptFor(graphInput, lang).includes('Language:'), false);
+    assert.equal(prompts.filePromptFor(fileInput, lang).includes('Language:'), false);
+  }
+
+  for (const lang of ['Indonesian', 'Spanish', 'French', 'custom-lang']) {
+    const graphPrompt = prompts.graphPromptFor(graphInput, lang);
+    const filePrompt = prompts.filePromptFor(fileInput, lang);
+    const expectedInstruction = `\nLanguage: Generate all facts, cues, questions, and answers in ${lang}. Maintain technical terms, identifiers, or mathematical formulas in standard form.`;
+    assert.ok(graphPrompt.endsWith(expectedInstruction));
+    assert.ok(filePrompt.endsWith(expectedInstruction));
+  }
+});
