From dab7e19de16fdebd7aac33f66c2570d4d9178723 Mon Sep 17 00:00:00 2001
From: hmty11 <darrenjeho@gmail.com>
Date: Thu, 12 Nov 2026 08:52:12 +0800
Subject: [PATCH 09/17] fix(tooling): prevent nested patches, fix fork-sync
 push/force-release, and make 9router test hermetic

---
 .github/workflows/fork-sync-release.yml | 25 ++++++++++++++-----------
 components/settings/agent-section.tsx   |  1 +
 scripts/patch-sync.mjs                  |  6 +++---
 tests/9router.test.ts                   |  6 +++---
 4 files changed, 21 insertions(+), 17 deletions(-)

diff --git a/.github/workflows/fork-sync-release.yml b/.github/workflows/fork-sync-release.yml
index 8878689..7d70510 100644
--- a/.github/workflows/fork-sync-release.yml
+++ b/.github/workflows/fork-sync-release.yml
@@ -59,7 +59,7 @@ jobs:
               git commit -m "chore(patches): refresh patches against upstream" || true
             fi
             echo "Pushing synced main branch to origin/main..."
-            git push origin main
+            git push --force-with-lease origin main
           else
             echo "Fork main is already up to date with upstream/main."
           fi
@@ -74,20 +74,23 @@ jobs:
           echo "version=${VERSION}" >> "$GITHUB_OUTPUT"
           echo "tag=${TAG}" >> "$GITHUB_OUTPUT"
 
-          EXISTS="false"
-          if gh release view "$TAG" --repo hmnty11/learnharness >/dev/null 2>&1; then
-            IS_DRAFT=$(gh release view "$TAG" --repo hmnty11/learnharness --json isDraft -q .isDraft 2>/dev/null || echo "false")
-            if [ "$IS_DRAFT" = "false" ]; then
-              EXISTS="true"
-            fi
-          fi
+          RELEASES_JSON=$(gh release list --repo hmnty11/learnharness --limit 100 --json tagName,isDraft)
+          RELEASE_STATE=$(printf '%s' "$RELEASES_JSON" | TAG="$TAG" node -e '
+            const fs = require("node:fs");
+            const list = JSON.parse(fs.readFileSync(0, "utf8"));
+            const match = list.find((r) => r.tagName === process.env.TAG);
+            if (match) process.stdout.write(match.isDraft ? "draft" : "published");
+          ')
 
-          if [ "$EXISTS" = "false" ] || [ "$FORCE_RELEASE" = "true" ]; then
-            echo "Release $TAG needs to be built and published."
+          if [ "$RELEASE_STATE" != "published" ] || [ "$FORCE_RELEASE" = "true" ]; then
+            echo "Release $TAG needs to be built and published (state: ${RELEASE_STATE:-none}, force: $FORCE_RELEASE)."
             echo "should_release=true" >> "$GITHUB_OUTPUT"
-            if ! gh release view "$TAG" --repo hmnty11/learnharness >/dev/null 2>&1; then
+            if [ -z "$RELEASE_STATE" ]; then
               echo "Creating initial draft release $TAG on hmnty11/learnharness..."
               gh release create "$TAG" --repo hmnty11/learnharness --draft --title "LearnHarness $TAG (Patched)" --notes "LearnHarness $TAG with custom fork patches for hmnty11/learnharness."
+            elif [ "$RELEASE_STATE" = "published" ] && [ "$FORCE_RELEASE" = "true" ]; then
+              echo "Converting existing published release $TAG back to draft for asset re-upload..."
+              gh release edit "$TAG" --repo hmnty11/learnharness --draft=true
             fi
           else
             echo "Release $TAG is already published on hmnty11/learnharness. Skipping release build."
diff --git a/components/settings/agent-section.tsx b/components/settings/agent-section.tsx
index 939716a..1742941 100644
--- a/components/settings/agent-section.tsx
+++ b/components/settings/agent-section.tsx
@@ -1114,6 +1114,7 @@ export function AgentSection({
 									<button
 										type="button"
 										data-testid="delete-personalization-button"
+										className="text-xs text-muted-foreground/70 underline-offset-2 hover:text-error hover:underline"
 										onClick={() => {
 											setSegmentDraft((prev) => {
 												const next = { ...prev };
diff --git a/scripts/patch-sync.mjs b/scripts/patch-sync.mjs
index 7f6fcd0..a1b1e52 100644
--- a/scripts/patch-sync.mjs
+++ b/scripts/patch-sync.mjs
@@ -86,7 +86,7 @@ function cmdExport(baseArg) {
   }
 
   // Count commits ahead
-  const count = getGitOutput(['rev-list', '--count', `${base}..HEAD`]);
+  const count = getGitOutput(['rev-list', '--count', `${base}..HEAD`, '--', '.', ':!patches']);
   if (!count || parseInt(count, 10) === 0) {
     console.warn(`⚠️ No commits found between ${base} and HEAD. Nothing to export.`);
     return;
@@ -97,7 +97,7 @@ function cmdExport(baseArg) {
   cleanPatchesDir();
 
   try {
-    runGit(['format-patch', `${base}..HEAD`, '-o', 'patches']);
+    runGit(['format-patch', `${base}..HEAD`, '-o', 'patches', '--', '.', ':!patches']);
   } catch (err) {
     console.error(`❌ Failed to export patches:`, err.message);
     process.exit(1);
@@ -202,7 +202,7 @@ function cmdStatus() {
   } else {
     console.log(`   No git am session active.`);
     const remote = getDefaultBaseRemote();
-    const ahead = getGitOutput(['rev-list', '--count', `${remote}/main..HEAD`], true);
+    const ahead = getGitOutput(['rev-list', '--count', `${remote}/main..HEAD`, '--', '.', ':!patches'], true);
     if (ahead) {
       console.log(`   Commits ahead of ${remote}/main: ${ahead}`);
     }
diff --git a/tests/9router.test.ts b/tests/9router.test.ts
index e068f21..57d1cec 100644
--- a/tests/9router.test.ts
+++ b/tests/9router.test.ts
@@ -15,7 +15,7 @@ describe("9router integration", () => {
 		const p9 = providers.find((p) => p.id === "9router");
 		assert.ok(p9, "9router in catalogProviders");
 		assert.equal(p9?.envVar, "NINEROUTER_API_KEY");
-		assert.equal(p9?.keyPresent, true);
+		assert.equal(typeof p9?.keyPresent, "boolean");
 	});
 
 	it("modelCatalog exposes 9router models", () => {
@@ -60,10 +60,10 @@ describe("9router integration", () => {
 		assert.equal(isWritableAuthKey("NINEROUTER_API_KEY"), true);
 	});
 
-	it("keyStatuses returns NINEROUTER_API_KEY when key is present", () => {
+	it("keyStatuses returns NINEROUTER_API_KEY status row", () => {
 		const statuses = keyStatuses();
 		const row = statuses.find((s) => s.id === "NINEROUTER_API_KEY");
 		assert.ok(row, "NINEROUTER_API_KEY status row exists");
-		assert.equal(row?.present, true);
+		assert.equal(typeof row?.present, "boolean");
 	});
 });
